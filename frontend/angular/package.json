{
  "name": "boilerplate-web-angular",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "preview": "ng serve --host 0.0.0.0",
    "codegen": "openapi-typescript ../../contract/openapi.yaml -o src/data/api/schema.d.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . && prettier --check . && depcruise \"src/**/*.ts\" && knip",
    "format": "prettier --write . && eslint --fix .",
    "test": "ng test --coverage"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/angular": "^17.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitest/coverage-v8": "^4.0.0",
    "angular-eslint": "^22.1.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^28.0.0",
    "knip": "^5.41.0",
    "openapi-typescript": "^7.5.0",
    "postcss": "^8.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.0.8"
  }
}
