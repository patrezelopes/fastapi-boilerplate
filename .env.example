# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_NAME=boilerplate-back
APP_ENV=development
APP_DEBUG=true

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000
API_BASE_PATH=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200

# ─── Banco ────────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=boilerplate
DB_PASSWORD=boilerplate
DB_NAME=boilerplate

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Gere um segredo real antes de qualquer deploy:  openssl rand -hex 32
# A aplicação recusa subir com este valor quando APP_ENV=production.
JWT_SECRET=troque-este-segredo-antes-de-qualquer-deploy
JWT_ISSUER=lopestech-boilerplate
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# COOKIE_SECURE=false só em desenvolvimento; em produção, sempre true.
COOKIE_SECURE=false
# Vazio = cookie host-only, o mais restrito. Preencha só para compartilhar a
# sessão entre subdomínios.
COOKIE_DOMAIN=
